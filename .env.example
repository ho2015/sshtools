# ==========================================
# sshtools Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values

# -------------------
# Application
# -------------------
NODE_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:5173

# -------------------
# Database (Prisma)
# -------------------
# SQLite (default - recommended for local development)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (uncomment and use if needed)
# DATABASE_URL="postgresql://user:password@localhost:5432/sshtools?schema=public"

# -------------------
# Encryption (Critical)
# -------------------
# 32-byte key encoded in base64 (generate a new one for production)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY_RING="CHANGE_ME_TO_A_32_BYTE_BASE64_KEY_HERE________________"

# -------------------
# Authentication & Security
# -------------------
JWT_SECRET="change-this-to-a-long-random-secret-string"
JWT_EXPIRES_IN=7d

# WebSocket ticket expiration (in seconds)
WS_TICKET_EXPIRY=300

# -------------------
# Logging
# -------------------
LOG_LEVEL=info

# -------------------
# Security Settings
# -------------------
# Comma-separated list of allowed CIDRs (leave empty to allow all)
ALLOWED_CIDRS=

# Enable strict SSRF protection (recommended: true)
STRICT_SSRF_PROTECTION=true

# -------------------
# Optional: Production Settings
# -------------------
# TRUST_PROXY=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
